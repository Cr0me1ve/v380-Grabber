# @enabled on
# @id 1
# @admin_only off
# @storage_device custom-path
# @network_server 
# @network_share_name 
# @network_smb_ver 1.0
# @network_username 
# @network_password 
# @upload_enabled off
# @upload_picture on
# @upload_movie on
# @upload_service ftp
# @upload_server 
# @upload_port 
# @upload_method POST
# @upload_location 
# @upload_subfolders on
# @upload_username 
# @upload_password 
# @upload_endpoint_url 
# @upload_access_key 
# @upload_secret_key 
# @upload_bucket 
# @upload_sse_c_key 
# @clean_cloud_enabled off
# @webcam_resolution 100
# @webcam_server_resize off
# @motion_detection on
# @preserve_pictures 0
# @manual_snapshots on
# @preserve_movies 7
# @manual_record off
# @working_schedule 
# @working_schedule_type outside
# @lang en


netcam_url http://v380-source:8081/video.mjpg
netcam_userpass 
width 640
height 360
camera_name Camera
auto_brightness off
framerate 15
rotate 0
mask_privacy 
target_dir /var/lib/motioneye/{{archive_subdir}}
stream_localhost on
stream_port 9081
stream_maxrate 15
stream_quality 85
stream_motion 0
stream_auth_method 0
text_left 
text_right %Y-%m-%d\n%T
text_scale 1
text_changes off
locate_motion_mode off
locate_motion_style redbox
threshold 4608
threshold_maximum 0
threshold_tune off
noise_tune on
noise_level 33
lightswitch_percent 0
despeckle_filter 
minimum_motion_frames 3
smart_mask_speed 0
mask_file 
movie_output_motion off
picture_output_motion off
pre_capture 45
post_capture 75
picture_output off
picture_filename 
emulate_motion off
event_gap 15
snapshot_interval 0
snapshot_filename 
picture_quality 85
movie_filename %Y-%m-%d/%H-%M-%S
movie_max_time {{duration}}
movie_output on
movie_passthrough off
movie_codec mp4
movie_quality 75
on_event_start /usr/local/lib/python3.13/dist-packages/motioneye/scripts/relayevent.sh "/etc/motioneye/motioneye.conf" start %t
on_event_end /usr/local/lib/python3.13/dist-packages/motioneye/scripts/relayevent.sh "/etc/motioneye/motioneye.conf" stop %t
on_movie_end /usr/local/lib/python3.13/dist-packages/motioneye/scripts/relayevent.sh "/etc/motioneye/motioneye.conf" movie_end %t "%f"; python3 /helpers/queue_movie.py "%f"
on_picture_save /usr/local/lib/python3.13/dist-packages/motioneye/scripts/relayevent.sh "/etc/motioneye/motioneye.conf" picture_save %t %f
stream_authentication 
netcam_params framerate = 15, capture_rate = 16, analyzeduration = 500000, probesize = 32768, rw_timeout = 3000000, reconnect_on_http_error = 503, reconnect_delay_max = 2, reconnect_max_retries = 2, reconnect_delay_total_max = 6
